# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
TAVILY_API_KEY=

# Defaults to local SQLite if unset.
# Docker Compose: postgresql://app:app@db:5432/research
DATABASE_URL=sqlite:///./research_agent.db

# aisuite model ids use the "provider:model" format.
PLANNER_MODEL=openai:gpt-5.6-terra
RESEARCH_MODEL=openai:gpt-6-luna
WRITER_MODEL=openai:gpt-6-luna
EDITOR_MODEL=openai:gpt-6-luna
